PORT=3000

DATABASE_URL=postgres://status:status@localhost:5432/status_db
REDIS_HOST=localhost
REDIS_PORT=6379

# Required: statuses are tagged by OpenAI. Without a key, new statuses end up in state "failed".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Shared tag list; OpenAI reuses these tags and appends new ones here.
TAGS_FILE=data/tags.json
